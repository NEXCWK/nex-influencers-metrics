PORT=3001
JWT_SECRET=seu_jwt_secret_aqui
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
NODE_ENV=production
FRONTEND_URL=https://seu-frontend.railway.app

# Relatório mensal por e-mail (opcional — sem isso, o relatório é gerado
# normalmente mas o envio fica desativado). Funciona com QUALQUER provedor
# que exponha um relé SMTP: uma caixa nex.work (Google Workspace/Office 365)
# ou o SMTP de um serviço transacional (Resend, SendGrid, Postmark...).
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@nex.work
SMTP_PASS=sua_senha_ou_api_key
SMTP_FROM="Nex Influencer Metrics <relatorios@nex.work>"
# Destinatários do relatório mensal (opcional — padrão: felipe@nex.work, luiza@nex.work)
MONTHLY_REPORT_RECIPIENTS=felipe@nex.work,luiza@nex.work
